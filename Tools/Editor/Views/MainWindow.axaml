<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pip3DEditor.ViewModels"
        xmlns:controls="using:Pip3DEditor.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Pip3DEditor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1520"
        Height="920"
        MinWidth="1180"
        MinHeight="760"
        Background="#12151B"
        Foreground="#F3F5F7"
        Icon="/Assets/avalonia-logo.ico"
        Title="Pip3D Editor">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>
    <Window.Styles>
        <Style Selector="Button.toolbar">
            <Setter Property="Background" Value="#222A35" />
            <Setter Property="Foreground" Value="#F3F5F7" />
            <Setter Property="BorderBrush" Value="#303A48" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.toolbarAccent">
            <Setter Property="Background" Value="#F97316" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#F97316" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.toolbarDanger">
            <Setter Property="Background" Value="#3A1B1F" />
            <Setter Property="Foreground" Value="#FFD7D9" />
            <Setter Property="BorderBrush" Value="#6A2B35" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0F141B" />
            <Setter Property="BorderBrush" Value="#2B3442" />
            <Setter Property="Foreground" Value="#F3F5F7" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="#12151B">
        <Border Grid.Row="0" Background="#171B22" BorderBrush="#252B35" BorderThickness="0,0,0,1" Padding="18,14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="New Scene" Command="{Binding NewSceneCommand}" Classes="toolbar" />
                    <Button Content="Open" Click="OpenScene_Click" Classes="toolbar" />
                    <Button Content="Save" Click="SaveScene_Click" Classes="toolbar" />
                    <Button Content="Save As" Click="SaveSceneAs_Click" Classes="toolbar" />
                    <Separator Width="16" Opacity="0" />
                    <Button Content="Add Root" Click="AddRootAsset_Click" Classes="toolbarAccent" />
                    <Button Content="Add Child" Click="AddChildAsset_Click" Classes="toolbar" />
                    <Button Content="Duplicate" Command="{Binding DuplicateSelectedCommand}" Classes="toolbar" />
                    <Button Content="Delete" Command="{Binding DeleteSelectedCommand}" Classes="toolbarDanger" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SceneName}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding SceneSummary}" FontSize="12" Foreground="#93A1B3" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="290,*,340" RowDefinitions="*,230" Margin="12" ColumnSpacing="12" RowSpacing="12">
            <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Background="#171B22" BorderBrush="#252B35" BorderThickness="1" CornerRadius="14" Padding="14">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <StackPanel>
                        <TextBlock Text="Hierarchy" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Scene graph and node structure" FontSize="12" Foreground="#93A1B3" />
                    </StackPanel>

                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding RootNodes}"
                              SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                              Background="Transparent">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate DataType="vm:SceneNodeViewModel" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{Binding ColorHex}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding NodeType}" Foreground="#7F8A9A" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Grid.Row="0" Background="#0E1218" BorderBrush="#252B35" BorderThickness="1" CornerRadius="14" Padding="12">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Viewport" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Quick scene preview and selection surface" FontSize="12" Foreground="#93A1B3" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1F2732" CornerRadius="999" Padding="12,6">
                            <TextBlock Text="Editor Camera" Foreground="#D8E0EA" FontSize="12" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Background="#0B0F14" CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <controls:EngineViewportHost />
                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="14"
                                    Background="#660B1016"
                                    CornerRadius="10"
                                    Padding="10,6">
                                <TextBlock Text="Live Pip3D Viewport"
                                           Foreground="#F3F5F7"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Grid.Row="0" Background="#171B22" BorderBrush="#252B35" BorderThickness="1" CornerRadius="14" Padding="14">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <StackPanel>
                        <TextBlock Text="Inspector" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedNode.NodeType, FallbackValue=No node selected}" FontSize="12" Foreground="#93A1B3" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Name" Foreground="#93A1B3" />
                                <TextBox Text="{Binding SelectedNode.Name, Mode=TwoWay}" Watermark="Node name" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Type" Foreground="#93A1B3" />
                                    <TextBox Text="{Binding SelectedNode.NodeType, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Color" Foreground="#93A1B3" />
                                    <TextBox Text="{Binding SelectedNode.ColorHex, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <CheckBox Content="Visible" IsChecked="{Binding SelectedNode.IsVisible, Mode=TwoWay}" />
                                <CheckBox Grid.Column="1" Content="Cast Shadows" IsChecked="{Binding SelectedNode.CastsShadows, Mode=TwoWay}" />
                            </Grid>

                            <Border Background="#11161D" CornerRadius="10" Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Transform" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="70,*,70,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <TextBlock Text="Pos X" VerticalAlignment="Center" Foreground="#93A1B3" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedNode.PositionX, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="Pos Y" VerticalAlignment="Center" Foreground="#93A1B3" />
                                        <TextBox Grid.Column="3" Text="{Binding SelectedNode.PositionY, Mode=TwoWay}" />

                                        <TextBlock Grid.Row="1" Text="Pos Z" VerticalAlignment="Center" Foreground="#93A1B3" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedNode.PositionZ, Mode=TwoWay}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Rot X" VerticalAlignment="Center" Foreground="#93A1B3" />
                                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SelectedNode.RotationX, Mode=TwoWay}" />

                                        <TextBlock Grid.Row="2" Text="Rot Y" VerticalAlignment="Center" Foreground="#93A1B3" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedNode.RotationY, Mode=TwoWay}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Rot Z" VerticalAlignment="Center" Foreground="#93A1B3" />
                                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding SelectedNode.RotationZ, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="#11161D" CornerRadius="10" Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Scale" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="70,*,70,*" ColumnSpacing="8">
                                        <TextBlock Text="Scale X" VerticalAlignment="Center" Foreground="#93A1B3" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedNode.ScaleX, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2" Text="Scale Y" VerticalAlignment="Center" Foreground="#93A1B3" />
                                        <TextBox Grid.Column="3" Text="{Binding SelectedNode.ScaleY, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                                        <TextBlock Text="Scale Z" VerticalAlignment="Center" Foreground="#93A1B3" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedNode.ScaleZ, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="#1A2230" CornerRadius="10" Padding="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Live Summary" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedNode.TransformSummary}" TextWrapping="Wrap" Foreground="#C6D0DD" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Background="#171B22" BorderBrush="#252B35" BorderThickness="1" CornerRadius="14" Padding="14">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Assets" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Palette for scene assembly" FontSize="12" Foreground="#93A1B3" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Add Selected Asset" Click="AddRootAsset_Click" Classes="toolbarAccent" />
                    </Grid>

                    <ListBox Grid.Row="1"
                             Name="AssetList"
                             ItemsSource="{Binding Assets}"
                             SelectedItem="{Binding SelectedAsset, Mode=TwoWay}"
                             DoubleTapped="AssetList_DoubleTapped"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:AssetItemViewModel">
                                <Border Background="#10151C" BorderBrush="#252B35" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="10">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="{Binding ColorHex}" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#AAB5C4" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#1A2230" CornerRadius="999" Padding="10,5" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Category}" Foreground="#D8E0EA" FontSize="12" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#171B22" BorderBrush="#252B35" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusText}" Foreground="#C8D0DB" />
                <TextBlock Grid.Column="1" Text="{Binding ScenePath}" Foreground="#718091" FontSize="12" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
